# JOIN production environment template
# Copy this file to .env on the VPS and replace every secret placeholder.
# Never commit the real production .env file.

# Docker Compose
COMPOSE_PROJECT_NAME=join-backend
APP_PORT=8001

# Runtime images
POSTGRES_IMAGE=postgres:18-alpine
REDIS_IMAGE=redis:8-alpine

# Django
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=join-api.ahmet-balci.de,127.0.0.1,localhost
DJANGO_LOG_LEVEL=INFO

# Frontend / CORS
DJANGO_CORS_ALLOWED_ORIGINS=https://ahmet-balci.de

# HTTPS / reverse proxy
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_TRUST_PROXY_SSL_HEADER=True

# HSTS
# Increase deliberately only after HTTPS has been verified in production.
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

# PostgreSQL
DB_NAME=join
DB_USER=join
DB_PASSWORD=replace-with-a-strong-database-password
DB_CONN_MAX_AGE=60

# Cache / API throttling
JOIN_TASK_CACHE_TIMEOUT=30
JOIN_LOGIN_RATE=10/min
JOIN_REGISTER_RATE=5/min
JOIN_GUEST_RATE=5/min
