# Docker Compose project isolation
COMPOSE_PROJECT_NAME=join-backend
APP_PORT=8001

# Images
POSTGRES_IMAGE=postgres:18-alpine
REDIS_IMAGE=redis:8-alpine

# Django
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
DJANGO_ALLOWED_HOSTS=join-api.ahmet-balci.de
DJANGO_LOG_LEVEL=INFO
DJANGO_CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_TRUST_PROXY_SSL_HEADER=True
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

# PostgreSQL
DB_NAME=join
DB_USER=join
DB_PASSWORD=replace-with-a-strong-production-database-password
DB_CONN_MAX_AGE=60

# Cache / throttling
JOIN_TASK_CACHE_TIMEOUT=30
JOIN_LOGIN_RATE=10/min
JOIN_REGISTER_RATE=5/min
JOIN_GUEST_RATE=5/min
