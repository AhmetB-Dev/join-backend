# Local development defaults
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_LOG_LEVEL=INFO

# Database
# Plain local Django development can keep sqlite.
# Docker Compose overrides DB_ENGINE/DB_HOST so the web container uses PostgreSQL.
DB_ENGINE=sqlite
DB_NAME=join
DB_USER=join
DB_PASSWORD=replace-with-a-strong-database-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Production frontend origin(s), comma-separated when frontend/API are cross-origin.
# Leave empty for same-origin deployments.
DJANGO_CORS_ALLOWED_ORIGINS=

# Production HTTPS / reverse proxy settings
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_TRUST_PROXY_SSL_HEADER=False

# Enable HSTS only after HTTPS works reliably in production.
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

# Shared cache / shared DRF throttle state.
# Plain local development may leave this empty and uses an in-process LocMem cache.
# Docker Compose supplies redis://redis:6379/0 to the web container.
REDIS_URL=
JOIN_TASK_CACHE_TIMEOUT=30
JOIN_LOGIN_RATE=10/min
JOIN_REGISTER_RATE=5/min
JOIN_GUEST_RATE=5/min
